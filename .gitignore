# ==================================
# Python
# ==================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ==================================
# Virtual Environments
# ==================================
venv/
.venv/
env/
.env/

# ==================================
# IDE & Editor
# ==================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# ==================================
# OS
# ==================================
.DS_Store
Thumbs.db
desktop.ini

# ==================================
# Logs & Tracking
# ==================================
*.log
wandb/
runs/
.mlflow/
.gemini/

# ==================================
# Jupyter
# ==================================
.ipynb_checkpoints/
*.ipynb

# ==================================
# Raw Dataset (never upload)
# ==================================
data/

# ==================================
# Paper / Docs (optional ignore)
# ==================================
paper/
paper_en/

# ==================================
# Local Web Visualization
# ==================================
web-viz/

# ==================================
# ================================
# CORE RULE: only keep code dirs
# ================================
# ==================================

# ❌ Ignore everything inside outputs
outputs/*

# ✔ But keep directory structure
!outputs/
!outputs/**/

# ✔ Only keep empty placeholders (.gitkeep)
!outputs/**/.gitkeep


# ==================================
# scripts rules (only code, no temp)
# ==================================
scripts/_*.py
!scripts/_rl_preflight.py
!scripts/_server_validate.py

# ==================================
# IMPORTANT NOTE:
# configs/ and src/ are NOT ignored
# (so they are fully tracked by git)
# ==================================